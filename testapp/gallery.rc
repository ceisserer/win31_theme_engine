/* gallery.rc - menus and dialogs of GALLERY.EXE */
#include <windows.h>
#include "gallery.h"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Controls dialog...",     CM_DIALOG
        MENUITEM "&Message box...",         CM_MSGBOX
        MENUITEM "Window &styles",          CM_STYLES
        MENUITEM "&Unload engine",          CM_UNLOAD
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   CM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Checked item",           CM_CHECKED, CHECKED
        MENUITEM "&Disabled item",          CM_DISABLED, GRAYED
        POPUP "&Submenu"
        BEGIN
            MENUITEM "Item &1",             CM_CHECKED
            MENUITEM "Item &2",             CM_CHECKED
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Gallery...",       CM_ABOUT
    END
END

IDD_CONTROLS DIALOG 20, 20, 250, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Controls"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Options", -1, 6, 4, 112, 92
    CONTROL         "&Normal", IDC_CHECK1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 16, 100, 10
    CONTROL         "&Checked", IDC_CHECK2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 30, 100, 10
    CONTROL         "&Three-state", IDC_CHECK3, "Button", BS_AUTO3STATE | WS_TABSTOP, 12, 44, 100, 10
    CONTROL         "Disabled", IDC_CHECK4, "Button", BS_AUTOCHECKBOX | WS_DISABLED, 12, 58, 100, 10
    CONTROL         "&Red", IDC_RADIO1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 72, 40, 10
    CONTROL         "&Green", IDC_RADIO2, "Button", BS_AUTORADIOBUTTON, 56, 72, 40, 10
    CONTROL         "Blue", IDC_RADIO3, "Button", BS_AUTORADIOBUTTON | WS_DISABLED, 12, 82, 40, 10
    LTEXT           "&Edit:", -1, 126, 6, 40, 8
    EDITTEXT        IDC_EDIT, 126, 16, 118, 12, ES_AUTOHSCROLL
    LTEXT           "&List:", -1, 126, 32, 40, 8
    LISTBOX         IDC_LIST, 126, 42, 56, 40, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    COMBOBOX        IDC_COMBO, 188, 42, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    SCROLLBAR       IDC_SCROLL, 126, 86, 118, 10
    LTEXT           "Disabled static text", IDC_DISABLED, 6, 102, 112, 8, WS_DISABLED
    CTEXT           "Centred static text", -1, 126, 102, 118, 8
    DEFPUSHBUTTON   "OK", IDOK, 6, 148, 56, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 68, 148, 56, 14
    PUSHBUTTON      "&Apply", IDC_APPLY, 130, 148, 56, 14, WS_DISABLED
END
